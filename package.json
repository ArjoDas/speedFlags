{
  "name": "speedflags",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:validate": "python3 scripts/data.py --check",
    "api:types": "openapi-typescript data/openapi.json -o frontend/src/api/schema.d.ts",
    "format": "prettier --write frontend/src tests/browser frontend/index.html *.ts *.js",
    "format:check": "prettier --check frontend/src tests/browser frontend/index.html *.ts *.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
